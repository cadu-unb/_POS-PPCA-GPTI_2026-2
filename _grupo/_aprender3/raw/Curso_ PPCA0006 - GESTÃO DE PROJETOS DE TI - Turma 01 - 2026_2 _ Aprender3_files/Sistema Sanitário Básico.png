<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (window.location.href == "https://aprender3.unb.br/course/request.php") {
            turma_div = document.getElementById("fitem_id_fullname");

            Alerta_element = `<div class="alert alert-danger m-2 rounded text-center w-50" id="yui_3_17_2_1_1664887184438_445"><b>Professor(a) Atenção!</b><br> Para evitar atraso ou recusa do seu pedido de criação de disciplina, informe corretamente o código SIGAA e a(s) turma(s) da sua disciplina.<br>
        <b id="yui_3_17_2_1_1664887184438_444">Exemplo:</b> "NUT0028 - Turma 01", "NUT0028 - Turma 02"...        
    </div>`
            alerta_element = document.createElement('div');
            alerta_element.innerHTML = Alerta_element;
            // add after turma_div
            titulo = document.querySelector("#region-main > div > h2");
            // inser alert element after titulo
            titulo.insertAdjacentElement('afterend', alerta_element);
            //document.getElementById('fitem_id_fullname').parentNode.insertBefore(alerta_element, titulo.nextSibling);
        }
    });
</script>



<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (window.location.href == "https://aprender3.unb.br/course/request.php") {
            // select input #id_fullname
            var input = document.querySelector('#id_fullname');
            // get the name of the professor #usermenu > span
            var professor = document.querySelector('#usermenu > span').innerText;
            // to upper case
            professor = professor.toUpperCase();
            // make datalist #lista-codigos
            var datalist = document.createElement('datalist');
            datalist.id = 'lista-codigos';
            var professor_values = values[professor];
            // add each option to datalist
            for (i = 0; i < professor_values.length; i++) {
                value = professor_values[i];
                var option = document.createElement('option');
                option.value = value;
                datalist.appendChild(option);
            }
            // add datalist to input
            input.appendChild(datalist);
            // add list attribute to input
            input.setAttribute('list', 'lista-codigos');
        }
    });
</script>

