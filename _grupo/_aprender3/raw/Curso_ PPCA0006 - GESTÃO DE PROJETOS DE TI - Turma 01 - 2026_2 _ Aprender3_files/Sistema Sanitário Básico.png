<script>
document.addEventListener("DOMContentLoaded", function () {
  const part001 = "https://aprender3";
  const part002 = ".unb";
  const part003 = ".br/webservice/rest/server.php";
  const endpoint = part001 + part002 + part003;

  const courseId = 18;
  const userId = Number((M && M.cfg && (M.cfg.userId || M.cfg.userid)) || 0);
  const token = "292d9d5d8f1da2c712c3770b3c856531";

  // ✅ “Contém” em vez de “termina com” (robusto a sufixos, ?query, #hash)
  const here = window.location.pathname + window.location.search + window.location.hash;
  const onRequestPage = here.indexOf("/course/request.php") !== -1;

  if (!onRequestPage) return; // só roda o WS nessa página

  $.ajax({
    url: endpoint,
    type: "POST",
    data: {
      wstoken: token,
      wsfunction: "core_enrol_get_users_courses",
      moodlewsrestformat: "json",
      userid: String(userId)
    },
    success: function (resp) {
      if (resp && resp.exception) {
        console.error("WS error:", resp.errorcode, resp.message);
        return;
      }

      const isEnrolled = Array.isArray(resp) && resp.some(c => Number(c.id) === courseId);

      if (!isEnrolled) {
        console.log(`Usuário ${userId} não está matriculado no curso ${courseId}, redirecionando...`);
        window.location.href = "https://aprender3.unb.br/";
      } else {
        console.log(`Usuário ${userId} está matriculado no curso ${courseId}`);
      }
    },
    error: function (xhr, status, error) {
      console.error("Erro WS:", xhr.responseText || error);
    }
  });
});
</script>
<style>
.botoes {
  margin: 40px 0;
}

.card-link {
  display: flex;
  flex-direction: column;
  justify-content: center;   /* centraliza vertical */
  align-items: center;       /* centraliza horizontal */
  min-height: 150px;         /* 👈 altura padrão */
  padding: 20px;
  text-align: center;
  border-radius: 10px;
  background: #ffffff;
  border: 2px solid #008041;
  transition: all 0.25s ease;
  text-decoration: none;
  color: #008041;
  font-weight: 600;
  font-size: 17px;
}

.card-link:hover {
  background: #008041;
  color: #ffffff;
  transform: translateY(-3px);
  text-decoration: none;
}

.card-sub {
  font-size: 13px;
  margin-top: 6px;
  font-weight: 400;
  opacity: 0.8;
}

.card-link:hover .card-sub {
  color: #ffffff;
  opacity: 0.9;
}

/* ===== RESET SEGURO ===== */
.hero,
.features {
    position: relative;
    z-index: 2;
}

/* ===== FUNDO FORTE (sem depender do body) ===== */
.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0d2b4d 0%, #1e4c75 50%, #62A17C 100%);
    z-index: -1;
border-radius:25px;

}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0d2b4d 0%, #1e4c75 50%, #62A17C 100%);
    background-image: url(https://cead.unb.br/wp-content/uploads/2026/03/Gemini_Generated_Image_b7x06wb7x06wb7x0.png);
    z-index: -1;
    border-radius: 25px;
    background-size: cover;
}

.hero {
    text-align: center;
    padding: 110px 20px 70px;
    color: #ffffff;
}

/* TITULOS */
.hero h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 20px;
}

.hero h2 {
    font-size: 1.4rem;
    font-weight: 400;
    opacity: 0.9;
}

/* ===== FEATURES ===== */
.features {
    display: flex;
    justify-content: center;
    gap: 30px;
    padding: 70px 20px 90px;
    max-width: 1200px;
    margin: auto;
    flex-wrap: wrap;
/*
background-image: url('https://cead.unb.br/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-27-at-18.08.41.jpeg');*/
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* BOXES COM COR REAL */
.feature-box {
    background: #ffffff;
    border-radius: 18px;
    width: 320px;
    text-align: center;
    border: 2px solid #e9e9e9;
    box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    transition: all 0.3s ease;
}

.feature-box:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(0,0,0,0.25);
}

/* ÍCONE */
.feature-icon {
    font-size: 48px;
    margin-bottom: 20px;
    color: #62A17C;
}

/* TEXTO INTERNO */
.feature-box h3 {
    font-size: 1.5rem;
    margin-bottom: 15px;
    font-weight: 600;
    color: #0d2b4d;
}

.feature-box p {
    font-size: 1rem;
    color: #555;
}

/* RESPONSIVO */
@media (max-width: 768px) {
    .hero {
        padding: 80px 20px 50px;
    }

    .hero h1 {
        font-size: 2rem;
    }

    .features {
        flex-direction: column;
        align-items: center;
    }

    .feature-box {
        width: 100%;
        max-width: 400px;
    }
}

#usernavigation>div.d-flex.align-items-stretch.usermenu-container>div>span>a {
    color: #0d5ca1 !important;
    font-weight: 900 !important;
}

</style>

