// recuperar a senha

document.addEventListener("DOMContentLoaded", function() {
    // 1. Seleciona o link de "esqueceu a senha" pelo caminho especificado
    const forgotPasswordLink = document.querySelector('#login > div.login-form-forgotpassword.form-group.text-center > a');

    if (forgotPasswordLink) {
        // 2. Remove as classes antigas (opcional, para evitar conflitos de estilo)
        forgotPasswordLink.className = '';

        // 3. Adiciona as novas classes de botão do Bootstrap
        forgotPasswordLink.classList.add('btn', 'btn-primary', 'btn-block', 'btn-lg');

        // 4. Altera o texto do link
        forgotPasswordLink.textContent = 'Recuperar a minha senha';

        // 5. Ajuste visual (opcional): adiciona um espaçamento no topo se o botão ficar colado
        forgotPasswordLink.style.marginTop = "15px";
        forgotPasswordLink.style.display = "block"; // Garante que o btn-block funcione corretamente
    }
});

