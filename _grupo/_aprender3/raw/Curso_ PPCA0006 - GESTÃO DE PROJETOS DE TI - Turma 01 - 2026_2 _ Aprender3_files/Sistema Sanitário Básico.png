<script>
// Usamos um pequeno intervalo para garantir que o RequireJS esteja pronto
(function() {
    var checkRequire = setInterval(function() {
        if (typeof require !== 'undefined') {
            clearInterval(checkRequire);
            require(['jquery', 'theme_boost/loader'], function($) {
                $(document).ready(function() {
                    const dataLimite = new Date("2026-10-28T23:59:00");
                    const agora = new Date();
                    const url = window.location.href;

                    if (url.indexOf("login/index.php") !== -1 && agora <= dataLimite) {
                        var $modal = $('#modal_popup_noticia');
                        if ($modal.length > 0) {
                            $modal.modal('show');
                        }
                    }
                });
            });
        }
    }, 50); // Checa a cada 50ms se o require foi definido
})();
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
    // Seleciona o drawer especificamente pelo data-region para evitar conflitos
    const drawer = document.querySelector('div.drawer.bg-white[data-region="right-hand-drawer"]');
    const btnSupport = document.querySelector('#btn-support-trigger');

    if (!drawer || !btnSupport) {
        console.warn('Elementos para ajuste do botão de suporte não encontrados.');
        return;
    }

    // Define a transição para o movimento ser suave
    btnSupport.style.transition = 'right 0.4s cubic-bezier(0.4, 0, 0.2, 1)';

    /**
     * Função que valida a classe do drawer e move o botão
     */
    const updateButtonPosition = () => {
        // Se a lista de classes contiver 'hidden', o drawer está fechado
        if (drawer.classList.contains('hidden')) {
            btnSupport.style.right = '20px';
        } else {
            // Caso contrário (está apenas como "drawer bg-white"), o drawer está aberto
            btnSupport.style.right = '340px';
        }
    };

    // Configura o MutationObserver para observar mudanças de atributos (especificamente a classe)
    const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
            if (mutation.attributeName === 'class') {
                updateButtonPosition();
                break; // Otimização: processa apenas uma vez por ciclo de mudança
            }
        }
    });

    // Inicia a observação
    observer.observe(drawer, { 
        attributes: true, 
        attributeFilter: ['class'] 
    });

    // Executa a verificação inicial ao carregar a página
    updateButtonPosition();
});


