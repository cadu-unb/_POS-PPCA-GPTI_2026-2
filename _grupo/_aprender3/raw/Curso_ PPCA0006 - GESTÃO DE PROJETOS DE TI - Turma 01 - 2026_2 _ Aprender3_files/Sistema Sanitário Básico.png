<script>
    $(document).ready(function() {
        $(".padraoDica").hide();
        $(".padraoSaibaMais").hide();

        var wWidth = $(window).width();
        var dWidth = wWidth * 0.6;

        var wHeight = $(window).height();
        var dHeight = wHeight * 0.9;

        $(".dialogo").dialog({

            width: dWidth,
            height: dHeight,
            modal: true,
            fluid: true,
            autoOpen: false,
            open: function() {
                $('.ui-widget-overlay').show().fadeIn();
            },
            close: function() {
                $('.ui-widget-overlay').hide().fadeOut();
            },
            show: {
                effect: "clip",
                duration: 1000
            },
            hide: {
                effect: "clip",
                duration: 500
            }
        });

        $(".dialogo2").dialog({

            width: 350,
            height: 350,
            modal: true,
            fluid: true,
            autoOpen: false,
            open: function() {
                $('.ui-widget-overlay').show().fadeIn();
            },
            close: function() {
                $('.ui-widget-overlay').hide().fadeOut();
            },
            show: {
                effect: "clip",
                duration: 1000
            },
            hide: {
                effect: "clip",
                duration: 500
            }
        });
    });

    $(".ui-widget-overlay").click(function() {
        $(this).hide();
        $(".ui-dialog").hide();
    });
    $(document).keyup(function(e) {
        if (e.keyCode == 27) {
            $(".ui-dialog").hide();
            $('.ui-widget-overlay').hide();
        }
    });

    function exibe(obj) {
        $("#" + obj).slideToggle("slow");
    }

    function abreDialogo(obj) {
        $("#" + obj).modal({
            show: true
        })
    };
</script>

