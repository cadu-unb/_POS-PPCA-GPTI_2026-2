<script>
    function addWebconfEl() {
        // select elemente that contains the text "Ferramenta externa" and the classes "optionname clamp-2"
        el = document.evaluate("//div[contains(text(), 'Ferramenta externa') and contains(@class, 'optionname clamp-2')]", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
        // get the 4th parent element
        el = el.parentElement.parentElement.parentElement;
        // duplicate the element
        el2 = el.cloneNode(true);
        // change "Ferramenta externa" to "WebConferencia"
        el2.querySelector(".optionname").innerHTML = "WebConferencia";
        // add the element next to the original
        el.parentElement.insertBefore(el2, el.nextSibling);
        svg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-webcam-fill" viewBox="0 0 16 16" style="
width: 30px;
height: 30px;
">
<path d="M6.644 11.094a.5.5 0 0 1 .356-.15h2a.5.5 0 0 1 .356.15c.175.177.39.347.603.496a7.166 7.166 0 0 0 .752.456l.01.006h.003A.5.5 0 0 1 10.5 13h-5a.5.5 0 0 1-.224-.947l.002-.001.01-.006a3.517 3.517 0 0 0 .214-.116 7.5 7.5 0 0 0 .539-.34c.214-.15.428-.319.603-.496ZM7 6.5a1 1 0 1 1 2 0 1 1 0 0 1-2 0Z"></path>
<path d="M2 3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H2Zm6 1.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM12.5 7a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1Z"></path>
</svg>`;
        // change the image inside the el to svg
        el2.querySelector("img").outerHTML = svg;
        // change the id of the el2 to element_addedit
        el2.id = "element_addedit";


    }

    // if url contains "https://aprender3.unb.br/course/view.php?id="
    if (window.location.href.includes("https://aprender3.unb.br/course/view.php?id=")) {

        // on click on any of the .section-modchooser-link elements
        document.querySelectorAll(".section-modchooser-link").forEach(function(el) {
            el.addEventListener("click", function() {
                // wait 1 second
                setTimeout(function() {
                    addWebconfEl();
                }, 1000);
            });
        });
        document.querySelectorAll(".nav-item.nav-link").forEach(function(el) {
            el.addEventListener("click", function() {
                // wait 1 second
                setTimeout(function() {
                    addWebconfEl();
                }, 1000);
            });
        });

    }
    // if url has https://aprender3.unb.br/course/modedit.php?add=lti&type=&course= then run the function
    if (window.location.href.includes("https://aprender3.unb.br/course/modedit.php?add=lti&type=&course=")) {
        // select input select #id_typeid
        input_select = document.getElementById("id_typeid");
        // change option to WebConferencia
        input_select.value = "15";
    }
</script>






