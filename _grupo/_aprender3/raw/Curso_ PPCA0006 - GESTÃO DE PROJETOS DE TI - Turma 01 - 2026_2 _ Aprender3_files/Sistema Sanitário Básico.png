<script>
    var textArea = $('#id_reason');
    var form = textArea.closest('form');
    form.submit(function(event) {
        let date_ob = new Date();
        let date = ("0" + date_ob.getDate()).slice(-2);
        let month = ("0" + (date_ob.getMonth() + 1)).slice(-2);
        let year = date_ob.getFullYear();
        let hours = date_ob.getHours();
        if (hours < 0 && hours < 10) {
            hours = "0" + hours;
        } else {
            hours = hours;
        }
        let minutes = date_ob.getMinutes();
        if (minutes < 0 && minutes < 10) {
            minutes = "0" + minutes;
        } else {
            minutes = minutes;
        }
        var info = "\n5 - Criado pelo Sistema - Data de solicitação: " + date + "/" + month + "/" + year + " as " + hours + ":" + minutes;
        var message = document.getElementById("id_reason").value;
        message = message + info;
        document.getElementById("id_reason").value = message;
        console.log(message);
        //window.alert(message);
    });
</script>

