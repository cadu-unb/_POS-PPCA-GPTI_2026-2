<script>


loaded = false;
function carregarScript(url, callback) {
    if (loaded) {
        return;
    }
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = url;
    script.onload = callback;
    document.body.appendChild(script);
}

function abreOZammad() {
    require(['jquery'], function($) {
        window.jQuery = window.$ = $;

        carregarScript("https://atendimento.cead.unb.br/assets/form/form.js", function() {
            carregarScript("https://atendimento.cead.unb.br/assets/chat/chat-no-jquery.min.js", function() {
                $('#zammad-feedback-form').ZammadForm({
                    messageTitle: 'Formulário para solicitação de suporte',
                    messageSubmit: 'Enviar',
                    messageThankYou: 'Obrigado por registrar sua dúvida! Nós responderemos o mais breve possível',
                    modal: true
                });

                new ZammadChat({
                    background: '#1a73e8',
                    fontSize: '12px',
                    chatId: 6,
                    show: true
                });
            });
        });

        setTimeout(function() {
            document.querySelector('.open-zammad-chat')?.click();
        }, 2000);
    });
}



</script>

